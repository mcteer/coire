{
  "components": {
    "schemas": {
      "AdapterSelector": {
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}@[a-z0-9][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "FailoverStatus": {
        "additionalProperties": false,
        "properties": {
          "elected_host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elected Host"
          },
          "in_flight": {
            "default": 0,
            "minimum": 0.0,
            "title": "In Flight",
            "type": "integer"
          },
          "reachable_members": {
            "items": {
              "type": "string"
            },
            "title": "Reachable Members",
            "type": "array",
            "uniqueItems": true
          },
          "snapshot_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Expires At"
          },
          "tier": {
            "$ref": "#/components/schemas/FailoverTier"
          },
          "unavailable_capabilities": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Unavailable Capabilities",
            "type": "array"
          }
        },
        "required": [
          "tier"
        ],
        "title": "FailoverStatus",
        "type": "object"
      },
      "FailoverTier": {
        "enum": [
          "full",
          "degraded_inference",
          "minimal"
        ],
        "title": "FailoverTier",
        "type": "string"
      },
      "GatewayModel": {
        "additionalProperties": false,
        "properties": {
          "coire_adapter_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coire Adapter Id"
          },
          "coire_base_model_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coire Base Model Id"
          },
          "coire_context_window": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coire Context Window"
          },
          "coire_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coire Description"
          },
          "coire_load_state": {
            "enum": [
              "loaded",
              "loading",
              "cold"
            ],
            "title": "Coire Load State",
            "type": "string"
          },
          "coire_source": {
            "$ref": "#/components/schemas/ModelSource",
            "default": "studio"
          },
          "coire_tags": {
            "items": {
              "type": "string"
            },
            "title": "Coire Tags",
            "type": "array"
          },
          "coire_variant_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coire Variant Id"
          },
          "coire_verified": {
            "default": false,
            "title": "Coire Verified",
            "type": "boolean"
          },
          "created": {
            "title": "Created",
            "type": "integer"
          },
          "id": {
            "$ref": "#/components/schemas/ModelSelector"
          },
          "object": {
            "const": "model",
            "default": "model",
            "title": "Object",
            "type": "string"
          },
          "owned_by": {
            "const": "coire",
            "default": "coire",
            "title": "Owned By",
            "type": "string"
          }
        },
        "required": [
          "id",
          "created",
          "coire_load_state"
        ],
        "title": "GatewayModel",
        "type": "object"
      },
      "GatewayModelList": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/GatewayModel"
            },
            "title": "Data",
            "type": "array"
          },
          "object": {
            "const": "list",
            "default": "list",
            "title": "Object",
            "type": "string"
          }
        },
        "required": [
          "data"
        ],
        "title": "GatewayModelList",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelSelector": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/AdapterSelector"
          }
        ]
      },
      "ModelSource": {
        "enum": [
          "studio",
          "openai",
          "anthropic"
        ],
        "title": "ModelSource",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Coire Failover",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/failover/tier": {
      "get": {
        "operationId": "tier_failover_tier_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailoverStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Tier"
      }
    },
    "/v1/chat/completions": {
      "post": {
        "operationId": "completions_v1_chat_completions_post",
        "parameters": [
          {
            "in": "header",
            "name": "cf-access-jwt-assertion",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cf-Access-Jwt-Assertion"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Completions"
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "models_v1_models_get",
        "parameters": [
          {
            "in": "header",
            "name": "cf-access-jwt-assertion",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cf-Access-Jwt-Assertion"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayModelList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Models"
      }
    }
  }
}
