{
  "title": "Coire Cluster",
  "uid": "coire-cluster",
  "schemaVersion": 39,
  "panels": [
    {"id": 1, "title": "edge-a control latency", "type": "timeseries", "targets": [{"expr": "coire_control_path_latency_ms{peer=\"coire-edge-a\"}"}]},
    {"id": 2, "title": "edge-b control latency", "type": "timeseries", "targets": [{"expr": "coire_control_path_latency_ms{peer=\"coire-edge-b\"}"}]},
    {"id": 3, "title": "Studio data link", "type": "stat", "targets": [{"expr": "coire_data_link_up"}]},
    {"id": 4, "title": "Sharding eligibility", "type": "stat", "targets": [{"expr": "coire_sharding_link_eligible", "legendFormat": "{{mode}}"}]},
    {"id": 5, "title": "Link measurement age", "type": "timeseries", "targets": [{"expr": "time() - coire_sharding_link_last_success_timestamp_seconds", "legendFormat": "{{transport}}"}]},
    {"id": 6, "title": "Sharded group transitions", "type": "timeseries", "targets": [{"expr": "sum by (state, mode) (rate(coire_sharding_group_transitions_total[5m]))", "legendFormat": "{{mode}} {{state}}"}]},
    {"id": 7, "title": "Placement benchmark tokens/s", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.5, sum by (le, placement) (rate(coire_sharding_benchmark_tokens_per_second_bucket[30m])))", "legendFormat": "{{placement}}"}]},
    {"id": 8, "title": "Authentication outcomes", "type": "timeseries", "targets": [{"expr": "sum by (method, outcome, reason) (rate(coire_auth_attempts_total[5m]))", "legendFormat": "{{method}} {{outcome}} {{reason}}"}]},
    {"id": 9, "title": "API key limit refusals", "type": "timeseries", "targets": [{"expr": "sum by (kind) (rate(coire_key_limit_refusals_total[5m]))", "legendFormat": "{{kind}}"}]},
    {"id": 10, "title": "Authentication audit failures", "type": "stat", "targets": [{"expr": "sum(increase(coire_auth_audit_failures_total[15m]))"}]}
  ]
}
