{
  "uid": "coire-control-efficiency",
  "title": "Coire control plane efficiency",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scheduler workers",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "coire_scheduler_workers_running"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kill queue latency (p95)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(coire_run_kill_queue_latency_seconds_bucket[5m])))"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Console projections per second",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "rate(coire_console_projections_total[5m])"}]
    }
  ]
}
