# Non-secret deployment inputs. Copy only the values needed by your environment.
COIRE_CONTROL_BIND_ADDRESS=127.0.0.1
COIRE_CONTROL_PORT=8180
COIRE_TAG=dev
# Registry UUID of the verified admin model pinned to Studio B.
COIRE_OPS_MODEL_ID=
# Released run images must be repository-digest references.
COIRE_RUN_AGENT_IMAGE=
COIRE_RUN_RELAY_IMAGE=
# Public election configuration. Leave the member name empty until all three keys are provisioned.
COIRE_FAILOVER_MEMBER_NAME=
COIRE_FAILOVER_CORE_PUBLIC_KEY=
COIRE_FAILOVER_EDGE_A_PUBLIC_KEY=
COIRE_FAILOVER_EDGE_B_PUBLIC_KEY=
