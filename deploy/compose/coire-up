#!/usr/bin/env bash
# Bring up the Coire control plane on core.
#
# Secrets are read from the macOS Keychain into complete, private generations outside Git.
# Existing container bind mounts are never overwritten in place.
#
# Two measured constraints force this shape (research R4, amended): compose rejects
# `environment:` secret sources for any read_only service, and a file source is a bind mount,
# so deleting it under a running container breaks `docker compose restart`. The secret is
# never in the repository, never in an image, and never on a Studio.
#
#   coire-up                      read secrets from the Keychain (normal path)
#   coire-up --secrets-from-env   use COIRE_SECRET_* already in the environment (CI)
#   coire-up --build              explicitly build images before startup
#   coire-up --no-build           compatibility alias for normal startup
#   coire-up --recover-db-role    back up existing data and align the persisted role
#
# Exit codes: 0 ok, 2 missing Keychain item, 3 another bring-up is already running.
set -euo pipefail

COMPOSE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$COMPOSE_DIR/../.." && pwd)"
export COIRE_REPO_ROOT="$REPO_ROOT"
STATE_ROOT="${COIRE_STATE_ROOT:-$HOME/.coire/projects}"
PROJECT="${COMPOSE_PROJECT_NAME:-coire}"
if [[ ! "$PROJECT" =~ ^[a-z][a-z0-9_-]{1,62}$ ]]; then
  echo "invalid Compose project name" >&2
  exit 2
fi
mkdir -p "$STATE_ROOT/$PROJECT"
chmod 700 "$STATE_ROOT/$PROJECT"
LOCKDIR="$STATE_ROOT/$PROJECT/.coire-up.lock"
WAIT_TIMEOUT="${COIRE_WAIT_TIMEOUT:-180}"
CONTROL_PORT="${COIRE_CONTROL_PORT:-8180}"
export COIRE_CONTROL_PORT="$CONTROL_PORT"

FROM_ENV=0
BUILD=0
RECOVER_DB_ROLE=0
for arg in "$@"; do
  case "$arg" in
    --secrets-from-env) FROM_ENV=1 ;;
    --build)            BUILD=1 ;;
    --no-build)         BUILD=0 ;;
    --recover-db-role)  RECOVER_DB_ROLE=1 ;;
    -h|--help)          sed -n '2,12p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $arg" >&2; exit 2 ;;
  esac
done

# Two operators must not race the migration (spec edge case). macOS ships no flock(1), so the
# lock is an atomic mkdir plus a PID file; a lock left by a killed run is detected as stale
# rather than blocking bring-up forever.
acquire_lock() {
  if mkdir "$LOCKDIR" 2>/dev/null; then
    echo "$$" > "$LOCKDIR/pid"
    trap 'rm -rf "$LOCKDIR"' EXIT
    return 0
  fi
  if [[ -r "$LOCKDIR/pid" ]]; then
    local holder
    holder="$(cat "$LOCKDIR/pid" 2>/dev/null || echo)"
    if [[ -n "$holder" ]] && ! kill -0 "$holder" 2>/dev/null; then
      echo "removing stale lock from pid $holder" >&2
      rm -rf "$LOCKDIR"
      if mkdir "$LOCKDIR" 2>/dev/null; then
        echo "$$" > "$LOCKDIR/pid"
        trap 'rm -rf "$LOCKDIR"' EXIT
        return 0
      fi
    fi
  fi
  return 1
}

if ! acquire_lock; then
  echo "bring-up already running (lock held at $LOCKDIR)" >&2
  exit 3
fi

# Resolve only the control-VLAN address; never widen the published listener.
if [[ -z "${COIRE_CONTROL_BIND_ADDRESS:-}" ]]; then
  if command -v dscacheutil >/dev/null 2>&1; then
    COIRE_CONTROL_BIND_ADDRESS="$(dscacheutil -q host -a name coire-core 2>/dev/null | awk '/ip_address:/{print $2; exit}')"
  else
    COIRE_CONTROL_BIND_ADDRESS="$(getent ahostsv4 coire-core 2>/dev/null | awk '{print $1; exit}' || true)"
  fi
  export COIRE_CONTROL_BIND_ADDRESS="${COIRE_CONTROL_BIND_ADDRESS:-127.0.0.1}"
fi

# --- secrets and installed release -----------------------------------------
# Collect every Keychain/environment input before touching a mounted credential.  A new
# generation is selected only for container recreation; existing bind mounts keep their inode.
export COIRE_SECRETS_BASE="${COIRE_SECRETS_BASE:-${COIRE_SECRETS_DIR:-$STATE_ROOT}}"
secret_args=(prepare)
if [[ "$FROM_ENV" -eq 1 ]]; then
  secret_args+=(--secrets-from-env)
fi
SECRETS_DIR="$(uv run python -m coire_core.deploy "${secret_args[@]}")"
export COIRE_SECRETS_DIR="$SECRETS_DIR"
RECREATE_SECRETS=0
active_manifest="$STATE_ROOT/$PROJECT/current/compose.json"
if [[ -f "$active_manifest" ]]; then
  active_secret_dir="$(python3 -c 'import json,sys; from pathlib import Path; m=json.load(open(sys.argv[1])); print(Path(m["secrets"]["postgres_password"]["file"]).parent)' "$active_manifest" 2>/dev/null || true)"
  [[ "$active_secret_dir" == "$SECRETS_DIR" ]] || RECREATE_SECRETS=1
elif [[ -n "$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" --filter 'label=com.docker.compose.service=postgres')" ]]; then
  RECREATE_SECRETS=1
fi
export MCP_ENABLED=false OPS_ENABLED=false
export DIAGNOSTICS_ENABLED=false COIRE_OTEL_CONFIG=config.yaml
case ",${COMPOSE_PROFILES:-}," in *,mcp,*) MCP_ENABLED=true ;; esac
case ",${COMPOSE_PROFILES:-}," in *,ops,*) OPS_ENABLED=true ;; esac
case ",${COMPOSE_PROFILES:-}," in *,diagnostics,*) DIAGNOSTICS_ENABLED=true; COIRE_OTEL_CONFIG=diagnostics.yaml ;; esac
export COIRE_MCP_ENABLED="$MCP_ENABLED" COIRE_OPS_ENABLED="$OPS_ENABLED"
export COIRE_DIAGNOSTICS_ENABLED="$DIAGNOSTICS_ENABLED"

# --- control names ---------------------------------------------------------
for node in coire-edge-a coire-edge-b; do
  if command -v dscacheutil >/dev/null 2>&1; then
    resolved="$(dscacheutil -q host -a name "$node" 2>/dev/null | awk '/ip_address:/{print $2; exit}')"
  else
    resolved="$(getent ahostsv4 "$node" 2>/dev/null | awk '{print $1; exit}' || true)"
  fi
  if [[ -z "$resolved" ]]; then
    echo "warning: control DNS name $node does not resolve" >&2
  fi
done

# --- bring up --------------------------------------------------------------
cd "$COMPOSE_DIR"
if [[ "$BUILD" -eq 1 ]]; then
  echo "building images..."
  docker compose build --quiet
fi
RELEASE="$(uv run python "$REPO_ROOT/scripts/coire-deploy.py" install "$SECRETS_DIR")"
# A clean host has no cached third-party base services. Pull only their pinned digest
# references; first-party services remain frozen to the locally installed image IDs.
docker compose -p "$PROJECT" -f "$RELEASE/compose.json" pull --policy missing \
  postgres docker-socket-proxy
if ! uv run python "$REPO_ROOT/scripts/coire-deploy.py" preflight "$RELEASE"; then
  if [[ "$RECOVER_DB_ROLE" -ne 1 ]]; then
    echo "retry with --recover-db-role only after reviewing the retained release and backup location" >&2
    exit 2
  fi
  uv run python "$REPO_ROOT/scripts/coire-deploy.py" recover-db-role "$SECRETS_DIR" \
    --backup-dir "$STATE_ROOT/$PROJECT/backups" --apply
  uv run python "$REPO_ROOT/scripts/coire-deploy.py" preflight "$RELEASE"
fi

echo "starting control plane (waiting up to ${WAIT_TIMEOUT}s for health)..."
up_args=(up --no-build --pull never -d --wait --wait-timeout "$WAIT_TIMEOUT")
if [[ "$RECREATE_SECRETS" -eq 1 ]]; then
  up_args+=(--force-recreate)
fi
docker compose -p "$PROJECT" -f "$RELEASE/compose.json" "${up_args[@]}"
uv run python "$REPO_ROOT/scripts/coire-deploy.py" select "$RELEASE"

echo
docker compose -p "$PROJECT" -f "$RELEASE/compose.json" ps --format 'table {{.Service}}\t{{.Status}}'
echo
echo "control plane up. health: http://${COIRE_CONTROL_BIND_ADDRESS}:${CONTROL_PORT}/health"
