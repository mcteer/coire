# Rendered only on coire-edge-a. This tunnel is outbound-only and points to a stateless frontend.
tunnel: ${COIRE_EDGE_A_TUNNEL_ID}
credentials-file: ${COIRE_EDGE_A_TUNNEL_CREDENTIALS_FILE}
ingress:
  - hostname: ${COIRE_PUBLIC_HOSTNAME}
    service: http://127.0.0.1:8004
  - service: http_status:404
